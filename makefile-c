##############################################################################
################################ makefile-c ##################################
##############################################################################
#                                                                            #
#   complete makefile of ScenarioReductionSolver                             #
#                                                                            #
#   The makefile defines internally all external libraries (comprised the    #
#   SMS++ one) required by ScenarioReductionSolver. Accordingly, all necessary         #
#   OBJ, H, -I directives, external libraries + -L< libdirs > are added to   #
#   the corresponding SRSk* macros.                                          #
#                                                                            #
#   Input:  $(CC)        = compiler command                                  #
#           $(SW)        = compiler options                                  #
#           $(SRSkSDR)  = the directory where ScenarioReductionSolver source is       #
#        $(SRSkODR)  = the directory where the objects have to be put        #
#                                                                            #
#   Output: $(SRSkOBJ)  = the final object(s) / library                      #
#              $(SRSkLIB)  = external libraries + -L< libdirs >              #
#     $(SRSkH)    = the .h files to include for ScenarioReductionSolver      #
#         $(SRSkINC)  = the -I$( ScenarioReductionSolver directory )         #
#                                                                            #
#                             Antonio Frangioni                              #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# define input macros for SMS++ complete makefile, then include it
SMS++SDR = $(SRSkSDR)/../SMS++
include $(SMS++SDR)/lib/makefile-c

# include the makefile requiring all external modules in input
include $(SRSkSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to SRSkINC, SRSkOBJ and SRSkH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
SRSkOBJ := $(SRSkOBJ) $(SMS++OBJ)
SRSkINC := $(SRSkINC) $(SMS++INC)

# external libraries for ScenarioReductionSolver
SRSkLIB = $(SMS++LIB)

############################ End of makefile #################################
