##############################################################################
################################# makefile-s #################################
##############################################################################
#                                                                            #
#   makefile of ScenarioReductionSolver and its dependencies, excluding      #
#   the core SMS++ one                                                       #
#                                                                            #
#   The makefile defines internally all external libraries required by       #
#   ScenarioReductionSolver, excluding the SMS++ core ones whose symbols are #
#   assumed to have been defined already (typically by including             #
#   SMS++/lib/makefile). Accordingly, all necessary OBJ, H, -I directives,   #
#   external libraries + -L< libdirs > are added to the corresponding        #
#   SRSk* macros.                                                            #
#                                                                            #
#   Input:  $(CC)        = compiler command                                  #
#           $(SW)        = compiler options                                  #
#           $(SMS++INC)  = the -I$( core SMS++ directory )                   #
#           $(SMS++OBJ)  = the core SMS++ library                            #
#           $(SRSkSDR)   = the directory where the source is                 #
#                                                                            #
#   Output: $(SRSkOBJ)   = the final object(s) / library                     #
#           $(SRSkLIB)   = external libraries + -L< libdirs >                #
#           $(SRSkH)     = the .h files to include                           #
#           $(SRSkINC)   = the -I$( source directory )                       #
#                                                                            #
#                             Antonio Frangioni                              #
#                        Dipartimento di Informatica                         #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# define input macros for the TwoStageStochasticBlock makefile-s
# (comprised StochasticBlock but not core SMS++), then include it
TSSBkSDR = $(SRSkSDR)/../TwoStageStochasticBlock
include $(TSSBkSDR)/makefile-s

# include the makefile requiring all external modules in input
include $(SRSkSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to SRSkINC, SRSkOBJ and SRSkH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
SRSkOBJ := $(SRSkOBJ) $(TSSBkOBJ)
SRSkH := $(SRSkH) $(TSSBkH)
SRSkINC := $(TSSBkINC) $(SRSkINC)

# external libraries for ScenarioReductionSolver
SRSkLIB = $(TSSBkLIB)

########################### End of makefile-s ################################
